.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.form-label {
  width: 120rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2b4a;
}

.form-input {
  flex: 1;
  background: #f5f8fc;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 32rpx;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #eef1f5;
}

.about-card {
  background: #f7f9fc;
}

.about-line {
  margin-top: 10rpx;
  line-height: 1.8;
}
