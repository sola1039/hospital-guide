.picker-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.picker-label {
  width: 64rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2f6fed;
}

.picker-value {
  flex: 1;
  background: #f5f8fc;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 34rpx;
  min-width: 520rpx;
}

.map-card {
  padding-bottom: 20rpx;
}

.floor-tabs {
  display: flex;
  margin-bottom: 16rpx;
}

.floor-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  margin: 0 8rpx;
  border-radius: 12rpx;
  background: #eef1f5;
  font-size: 32rpx;
  color: #555555;
}

.floor-tab.active {
  background: #2f6fed;
  color: #ffffff;
  font-weight: 700;
}

.floor-tab.has-route {
  border: 3rpx solid #e63946;
}

.map-canvas {
  width: 100%;
  height: 460rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
}

.map-hint {
  margin-top: 12rpx;
  text-align: center;
}

.route-summary {
  background: #e8f0fe;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 30rpx;
  color: #1a2b4a;
  margin-bottom: 12rpx;
}

.step-line {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e63946;
  margin: 16rpx 18rpx 0 4rpx;
  flex-shrink: 0;
}
